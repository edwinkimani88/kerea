# ============================================================
# KEREA — Apache .htaccess
# For cPanel / shared hosting with Apache + PHP 8+
# ============================================================

Options -Indexes
Options -MultiViews

# ── Charset & Error Pages ────────────────────────────────
AddDefaultCharset UTF-8
# ErrorDocument 404 /404.php
# ErrorDocument 500 /500.php

# ── Security Headers ─────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ── Block access to sensitive directories/files ──────────
<FilesMatch "\.(env|json|sql|log|lock|sh|md|git)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "^(settings\.json|composer\.json|package\.json|vercel\.json)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect the database directory
<IfModule mod_rewrite.c>
    RewriteRule ^database/ - [F,L]
    RewriteRule ^\.git/ - [F,L]
</IfModule>

# ── PHP Settings ─────────────────────────────────────────
<IfModule mod_php.c>
    php_value upload_max_filesize 25M
    php_value post_max_size 30M
    php_value max_execution_time 60
    php_value memory_limit 256M
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

# ── GZIP Compression ─────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
    AddOutputFilterByType DEFLATE application/json text/xml image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2 font/woff
</IfModule>

# ── Browser Caching ───────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg       "access plus 1 month"
    ExpiresByType image/png        "access plus 1 month"
    ExpiresByType image/webp       "access plus 1 month"
    ExpiresByType image/svg+xml    "access plus 1 month"
    ExpiresByType text/css         "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType font/woff2       "access plus 1 year"
    ExpiresByType font/woff        "access plus 1 year"
</IfModule>

# ── URL Rewriting ────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS (uncomment on live server)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Force www → non-www (uncomment and adjust for your domain)
    # RewriteCond %{HTTP_HOST} ^www\.kerea\.org [NC]
    # RewriteRule ^ https://kerea.org%{REQUEST_URI} [L,R=301]

    # Allow direct access to actual files and directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Block direct PHP access to backend internals
    RewriteRule ^backend/core/ - [F,L]
    RewriteRule ^backend/config/ - [F,L]
    RewriteRule ^backend/models/ - [F,L]

    # ── Clean URL Routing ─────────────────────────────────
    # Route /admin/* to admin PHP files
    RewriteRule ^admin/?$ admin/index.php [L]
    RewriteRule ^admin/([a-z_-]+)/?$ admin/$1.php [L,NC]

    # Route /auth/* to auth PHP files
    RewriteRule ^auth/?$ auth/index.php [L]
    RewriteRule ^auth/([a-z_-]+)/?$ auth/$1.php [L,NC]

    # Route /backend/api/* to API PHP files
    RewriteRule ^backend/api/([a-z_-]+)/?$ backend/api/$1.php [L,NC]

    # Route public page directories (trailing slash → index.php)
    RewriteRule ^(about|contact|events|news|publications|knowledge-hub|membership|member-directory|standards|policy-advocacy|partnerships|access-to-finance|market-development|kenya-renewable-energy-association)/?$ $1/index.php [L,NC]

    # Route membership sub-pages
    RewriteRule ^membership/([a-z_-]+)/?$ membership/$1.php [L,NC]
    RewriteRule ^membership/dashboard/([a-z_-]+)/?$ membership/dashboard/$1.php [L,NC]

    # Marketplace and vendor → redirect to external
    RewriteRule ^marketplace/?(.*)$ https://marketplace.kerea.org/$1 [R=301,L]
    RewriteRule ^vendor/?(.*)$ vendor/index.php [L]

    # Portal → redirect to membership
    RewriteRule ^portal/?$ /membership/ [R=301,L]
</IfModule>
