{
  "functions": {
    "**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/", "dest": "/index.php" },
    { "src": "/about/?", "dest": "/about/index.php" },
    { "src": "/contact/?", "dest": "/contact/index.php" },
    { "src": "/standards/?", "dest": "/standards/index.php" },
    { "src": "/marketplace/?", "dest": "/marketplace/index.php" },
    { "src": "/policy-advocacy/?", "dest": "/policy-advocacy/index.php" },
    { "src": "/member-directory/?", "dest": "/member-directory/index.php" },
    { "src": "/marketplace/product/?", "dest": "/marketplace/product/index.php" }
  ]
}
